<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light dark"><title>{{.Title}}</title>
<style>@media(max-width:600px){.outer{padding:16px 8px!important}.content{padding:24px 20px!important}.title{font-size:26px!important}}@media(prefers-color-scheme:dark){.page{background:#171923!important}.card{background:#252837!important;border-color:#44485e!important}.text{color:#f1f2fa!important}.muted{color:#b9bdd2!important}.panel{background:#303448!important}.brand{color:#c5c7ff!important}}</style></head>
<body class="page" style="margin:0;background:#f4f5fa;font-family:Arial,Helvetica,sans-serif;color:#22253d">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td class="outer" align="center" style="padding:36px 16px">
<table class="card" role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:640px;background:#ffffff;border:1px solid #dfe2ef;border-radius:20px;overflow:hidden">
<tr><td style="height:6px;background:#484ca4;font-size:0;line-height:0">&nbsp;</td></tr>
<tr><td class="content" style="padding:32px">
<p class="brand" style="margin:0 0 28px;color:#484ca4;font-size:19px;font-weight:bold;letter-spacing:.2px">Tayga Mail</p>
<p class="brand" style="margin:0 0 12px;color:#484ca4;font-size:13px;font-weight:bold;text-transform:uppercase;letter-spacing:1px">{{.Label}}</p>
<h1 class="text title" style="margin:0 0 24px;color:#22253d;font-size:30px;line-height:1.25;overflow-wrap:anywhere">{{.Title}}</h1>
<table class="panel" role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f0f1fa;border-radius:12px"><tr><td style="padding:20px">
<p class="muted" style="margin:0 0 8px;color:#656b84;font-size:12px;font-weight:bold;letter-spacing:.6px">КОГДА</p>
<p class="text" style="margin:0;font-size:17px;line-height:1.6;color:#22253d">{{.When}}</p>
{{if .Location}}<p class="muted" style="margin:20px 0 8px;color:#656b84;font-size:12px;font-weight:bold;letter-spacing:.6px">ГДЕ</p><p class="text" style="margin:0;font-size:16px;line-height:1.6;color:#22253d;overflow-wrap:anywhere">{{.Location}}</p>{{end}}
</td></tr></table>
{{if .Organizer}}<p class="muted" style="margin:24px 0 6px;color:#656b84;font-size:12px;font-weight:bold;letter-spacing:.6px">ОРГАНИЗАТОР</p><p class="text" style="margin:0;color:#22253d;font-size:15px;line-height:1.6;overflow-wrap:anywhere">{{.Organizer}}</p>{{end}}
{{if .Attendees}}<p class="muted" style="margin:20px 0 6px;color:#656b84;font-size:12px;font-weight:bold;letter-spacing:.6px">УЧАСТНИКИ</p>{{range .Attendees}}<p class="text" style="margin:0 0 4px;color:#22253d;font-size:15px;line-height:1.6;overflow-wrap:anywhere">{{.}}</p>{{end}}{{end}}
{{if .Description}}<div class="text" style="margin-top:24px;padding-top:20px;border-top:1px solid #dfe2ef;font-size:15px;line-height:1.65;color:#22253d;overflow-wrap:anywhere">{{range .Description}}{{.}}<br>{{end}}</div>{{end}}
{{if .Comment}}<p class="text" style="margin:20px 0 0;font-size:15px;line-height:1.65;color:#22253d;white-space:pre-line;overflow-wrap:anywhere">{{.Comment}}</p>{{end}}
<p class="muted" style="margin:28px 0 0;padding-top:20px;border-top:1px solid #dfe2ef;color:#656b84;font-size:13px;line-height:1.6">{{.Hint}}</p>
</td></tr></table>
</td></tr></table></body></html>
